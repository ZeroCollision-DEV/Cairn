#include <winver.h>
1 ICON "@CAIRN_ICON_DIR@/cairn_injector.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CAIRN_VERSION_COMMA@
 PRODUCTVERSION @CAIRN_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Cairn Injector\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "CairnInjector\0"
      VALUE "OriginalFilename", "CairnInjector.exe\0"
      VALUE "ProductName", "Cairn Injector\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
